---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { defaultLocale, locales, type Locale } from '../i18n';
import { getAbsoluteLocaleUrl } from 'astro:i18n';

interface Props {
  content: {
    title: string;
    description?: string;
  };
  currentLocale?: Locale;
  localizedPaths?: Partial<Record<Locale, string | undefined>>;
}

const { content, currentLocale: currentLocaleProp, localizedPaths } = Astro.props;

const currentLocale = (currentLocaleProp ?? Astro.currentLocale ?? defaultLocale) as Locale;
const basePath =
  import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizedPathname =
  basePath && Astro.url.pathname.startsWith(basePath)
    ? Astro.url.pathname.slice(basePath.length) || '/'
    : Astro.url.pathname;
const localePattern = new RegExp(`^/(${locales.join('|')})(?=/|$)`);
const pathWithoutLocale = normalizedPathname.replace(localePattern, '') || '/';
const pathParam = pathWithoutLocale === '/' ? undefined : pathWithoutLocale.replace(/^\/+/, '');
const currentPathParam = localizedPaths?.[currentLocale] ?? pathParam;
const canonicalUrl = getAbsoluteLocaleUrl(currentLocale, currentPathParam);
const xDefaultUrl = getAbsoluteLocaleUrl(
  defaultLocale,
  localizedPaths?.[defaultLocale] ?? pathParam,
);
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const alternateUrls = locales.map((locale) => ({
  locale,
  href: getAbsoluteLocaleUrl(locale, localizedPaths?.[locale] ?? pathParam),
}));
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={content.description || 'Hoesch@Home'} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrls.map((item) => <link rel="alternate" hreflang={item.locale} href={item.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <title>{content.title}</title>
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
